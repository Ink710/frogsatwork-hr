{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The app runs in the browser too, so pull in DOM types (base is Node-only libs).
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    // Next compiles JSX itself; tsc just needs to preserve it for type-checking.
    "jsx": "preserve",
    // The Next TS plugin adds route/config type-checking in editors.
    "plugins": [{ "name": "next" }],
    // Mirror the "@/..." import alias the app uses.
    "paths": { "@/*": ["./*"] },
    "incremental": true
  },
  // Only .ts/.tsx are type-CHECKED here; remaining .js files are still allowed (allowJs in the
  // base) and resolved as needed, just not checked — keeps the JS→TS migration incremental.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
