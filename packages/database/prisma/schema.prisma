// @hris/database — canonical schema for the HRIS suite.
//
// Prisma 7 note: connection URLs live in prisma.config.ts, NOT here.
//   - Migrate/Studio use datasource.url in prisma.config.ts → the `postgres`
//     OWNER role (DIRECT_URL), which can create tables and run privileged SQL.
//   - The runtime client (src/client.js) connects via a `pg` driver adapter using
//     the restricted `hris_app` role (DATABASE_URL).
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  MANAGER
  HR_GENERALIST
  HR_ADMIN
  PAYROLL_ADMIN
  RECRUITER
  SYSTEM
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

// FLSA exemption status — whether the role is overtime-exempt (US Fair Labor Standards Act).
// Versioned on EmployeeHistory because a promotion can flip it.
enum FlsaClassification {
  EXEMPT
  NON_EXEMPT
}

// How often the employee is paid. Versioned because it can change with a comp/role change.
enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
}

// The period the salary figure is expressed in — lets us render "MXN 78,000 / mo" vs "/ yr".
// Versioned alongside salary (they only make sense together).
enum PayBasis {
  PER_HOUR
  PER_MONTH
  PER_YEAR
}

enum DocumentType {
  CONTRACT
  IDENTIFICATION
  CERTIFICATION
  PERFORMANCE
  OTHER
}

enum AuditEventType {
  VIEW
  CREATE
  UPDATE
  CORRECTION
  TERMINATE
  REHIRE
  LEAVE
  SUSPEND
  REINSTATE
  EXPORT
  PERMISSION_DENIED
  LOGIN_FAILED
  // Time-management (PTO) decisions — the human approve/deny/cancel events on a leave request.
  // (Accrual entries are high-volume + automated; the ledger is their record, not the audit log.)
  TIME_OFF_REQUEST
  TIME_OFF_APPROVE
  TIME_OFF_DENY
  TIME_OFF_CANCEL
  // Timesheet decisions — submit + the reviewer's approve/reject (draft edits aren't audited).
  TIMESHEET_SUBMIT
  TIMESHEET_APPROVE
  TIMESHEET_REJECT
  // A manager/HR editing a report's SUBMITTED timesheet during review (someone else altering your hours).
  TIMESHEET_ADJUST
  // Shift swap/drop decisions (schedule CRUD + publish are not employee-scoped, so not audited here).
  SHIFT_SWAP_REQUEST
  SHIFT_SWAP_APPROVE
  SHIFT_SWAP_DENY
  // Attendance / clock — self punch in/out + a manager/HR correction of a punch (M4). Worked hours
  // and schedule variance are DERIVED at read time, so they are never audited; only the punches are.
  CLOCK_IN
  CLOCK_OUT
  CLOCK_CORRECTION
}

// A leave or a suspension — the two non-terminal, reversible status changes.
enum StatusChangeType {
  LEAVE
  SUSPENSION
}

// ---------------------------------------------------------------------------
// Time-management (PTO) enums — used by apps/time-management (M1).
// ---------------------------------------------------------------------------

// Kinds of time off. UNPAID is tracked for the record but never balance-checked (see LeavePolicy).
enum LeaveType {
  VACATION
  SICK
  PERSONAL
  UNPAID
}

// Lifecycle of a leave request. Terminal states: APPROVED / DENIED / CANCELLED.
enum LeaveRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// Why a ledger row exists. The balance for (employee, type) is the SUM of the signed `hours`
// across these entries — so a balance is always explainable by its entries (auditable ledger).
//   OPENING   — starting balance (seed / migration)
//   ACCRUAL   — automatic monthly grant (idempotent per period)
//   USAGE     — deduction when a request is APPROVED (negative)
//   ADJUSTMENT— manual HR correction (±)
//   REVERSAL  — credit back when an approved request is CANCELLED (positive)
enum LeaveLedgerSource {
  OPENING
  ACCRUAL
  USAGE
  ADJUSTMENT
  REVERSAL
}

// Lifecycle of a weekly timesheet. A REJECTED sheet becomes editable again → resubmit.
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Lifecycle of a shift drop/swap request.
enum ShiftSwapStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// Attendance / clock (M4). A ClockEvent is a single punch; worked hours are derived by pairing
// IN -> OUT within a day. An IN with no matching OUT is an "open" punch (forgot to clock out).
enum ClockEventType {
  IN
  OUT
}

// How a punch was recorded. WEB = the employee's own clock button; MANUAL = an HR/manager
// correction (e.g. closing a forgotten punch). Kiosk/geolocation sources are out of scope for M4.
enum ClockSource {
  WEB
  MANUAL
}

// Lifecycle of a project (M8). Never hard-deleted — archived so historical timesheet entries keep
// their reference; an ARCHIVED project just drops out of the employee's picker.
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Lifecycle of a recurring meeting (M10). Same shape as ProjectStatus but a DEDICATED enum so the
// two domains' lifecycles stay independent — an ARCHIVED meeting drops out of the timesheet activity
// picker while its historical TimeEntry references survive (never hard-deleted).
enum MeetingStatus {
  ACTIVE
  ARCHIVED
}

enum ActorType {
  USER
  SYSTEM
  INTEGRATION
}

// ---------------------------------------------------------------------------
// Recruiting (ATS) enums — used by apps/ats (M1). Visibility is per-job hiring
// TEAM (JobMember), a new access model on the same withViewer/RLS mechanics.
// ---------------------------------------------------------------------------

// Requisition lifecycle. Never hard-deleted — CLOSED / FILLED are the archive states.
enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  FILLED
}

// What SHAPE a per-job screening question takes (M6b). Deliberately small: these are screening
// questions, not a form builder. Each value is one renderer on the public form and one validation
// path — every addition costs both, plus an erasure consideration if it can hold free text.
enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_SELECT
}

// Where applicants come from, as a CLASSIFICATION (M2). Deliberately coarse and deliberately an
// enum: this is the axis /reports rolls up on, and a roll-up is only meaningful over a vocabulary
// that cannot drift. Named campaigns are the fine-grained layer above it — see Campaign.
//
// OTHER exists so a real channel we haven't enumerated can still be recorded honestly rather than
// mis-filed into the closest-looking option. Adding a channel is a migration, which is the point:
// the reportable vocabulary should change deliberately, not because someone typed something new.
enum SourceChannel {
  CAREERS_PAGE
  COMPANY_WEBSITE
  REFERRAL
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  JOB_BOARD
  OTHER
}

// A person's role on a SPECIFIC job's hiring team (distinct from their org-wide Role). Drives the
// app_can_see_job / app_can_manage_job RLS: managers/recruiters manage, interviewers are read-only (M1).
enum JobMemberRole {
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
}

// An interviewer's feedback is editable while DRAFT and frozen once SUBMITTED — the same lifecycle as
// a Timesheet. The lock is enforced by the UPDATE policy's USING clause, so it holds at the database.
enum ScorecardStatus {
  DRAFT
  SUBMITTED
}

// The overall verdict on a scorecard. Deliberately four options with no neutral middle: a debrief
// needs a position, and "maybe" is how hiring decisions stall.
enum Recommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

// Fixed top-level hiring pipeline (like TimesheetStatus / LeaveRequestStatus). The INTERVIEW phase is
// subdivided into per-job InterviewRounds; an Application in INTERVIEW points at its current round.
enum ApplicationStage {
  APPLIED
  SCREEN
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

// ---------------------------------------------------------------------------
// Compliance (M10) — voluntary EEO self-identification and the erasure lifecycle.
//
// Every EEO enum carries DECLINED, and it is the DEFAULT. "Prefer not to answer" is a real answer
// that must be reportable, not a null we have to guess the meaning of later — and defaulting to it
// means a form that is never filled in records a refusal rather than a fabricated value.
// ---------------------------------------------------------------------------

enum EeoGender {
  MALE
  FEMALE
  NON_BINARY
  DECLINED
}

// The US EEO-1 race/ethnicity categories. Stored as given; the aggregate report never breaks these
// down further, because a smaller bucket is a more identifiable one.
enum EeoEthnicity {
  HISPANIC_OR_LATINO
  WHITE
  BLACK_OR_AFRICAN_AMERICAN
  ASIAN
  NATIVE_HAWAIIAN_OR_PACIFIC_ISLANDER
  AMERICAN_INDIAN_OR_ALASKA_NATIVE
  TWO_OR_MORE_RACES
  DECLINED
}

enum EeoVeteranStatus {
  PROTECTED_VETERAN
  NOT_A_VETERAN
  DECLINED
}

enum EeoDisabilityStatus {
  YES
  NO
  DECLINED
}

// Why a candidate was rejected, as a STRUCTURED value (M12).
//
// Sits alongside the free-text `Application.rejectionReason` rather than replacing it, and that
// pairing is the point: the prose is blanked by an erasure (it is where names hide — see
// app_erase_candidate), while this enum survives, because a category identifies nobody. It is the
// only reason the "why do people get rejected?" report still balances after someone is forgotten.
//
// Fixed and org-wide ON PURPOSE. Per-requisition reasons — the JobCompetency pattern — cannot be
// compared across requisitions, and comparability is the entire reason this field exists.
enum RejectionReason {
  SKILLS_MISMATCH
  EXPERIENCE_LEVEL
  COMPENSATION_EXPECTATIONS
  STRONGER_CANDIDATE
  CANDIDATE_WITHDREW
  POSITION_CLOSED
  OTHER
}

// How a notification reached (or failed to reach) someone (M8).
//
// Only EMAIL exists. The in-portal banner is deliberately NOT a channel: it is derived at render
// time from the event trail the portal already reads, so there is nothing to deliver and nothing to
// record. The enum exists so M9's interviewer notifications can add one without a migration to
// widen a boolean.
enum NotificationChannel {
  EMAIL
}

// PENDING is written by the CLAIM, before the send is attempted — see app_claim_notification. It is
// the state that makes the claim atomic, not a queue.
//
// ⚠️ FAILED is the NORMAL state in production, by design: prod has no SMTP provider (see
// docs/DEPLOYMENT.md), so every send throws and is recorded as failed. That is the honest answer to
// "did we tell them" rather than a silence that reads as success.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// The ten EEO-1 Component 1 job categories (M12). A real filing reports headcounts BY category, so
// without this the export would be EEO-1-shaped without being an EEO-1.
enum EeoJobCategory {
  EXECUTIVE_SENIOR_OFFICIALS
  FIRST_MID_OFFICIALS
  PROFESSIONALS
  TECHNICIANS
  SALES_WORKERS
  ADMINISTRATIVE_SUPPORT
  CRAFT_WORKERS
  OPERATIVES
  LABORERS_HELPERS
  SERVICE_WORKERS
}

// Which of the two EEO export artifacts was produced. They exist separately because they answer to
// different audiences: SUMMARY carries the same small-cell suppression as the on-screen report and
// is for internal circulation; FILING contains EXACT headcounts because a regulator is entitled to
// them, is HR_ADMIN-only, and is the reason EeoExportLog exists at all.
enum EeoExportVariant {
  SUMMARY
  FILING
}

// An erasure request only ever ends one of two ways, and both are recorded: COMPLETED (the data was
// destroyed) or REFUSED (with a note — e.g. the person is now an employee and retention applies).
// There is no "cancelled" — a request that was made is a fact, and silently dropping it is exactly
// the behaviour the right to erasure exists to prevent.
// The lifecycle of one offer version (ATS M14). The shape is M7's scorecard lifecycle — draft
// freely, lock on submit — because an offer has the same property: it is a considered position that
// becomes a commitment the moment it leaves the building.
//
// ACCEPTED is terminal. EXTENDED and DECLINED may be REVISED, which supersedes the version rather
// than editing it: "what did we first offer, and what did they sign?" is a question a hiring
// post-mortem actually asks, and an in-place edit destroys the answer.
enum OfferStatus {
  DRAFT
  EXTENDED
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum ErasureRequestStatus {
  PENDING
  COMPLETED
  REFUSED
}

// ---------------------------------------------------------------------------
// Identity — built first because history/audit FKs point at User.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users           User[]
  employees       Employee[]
  departments     Department[]
  leavePolicies   LeavePolicy[]
  projects        Project[]
  meetings        Meeting[]
  jobs            Job[]
  candidates      Candidate[]
  applications    Application[]
  // Attribution registry (ATS M2).
  campaigns       Campaign[]
  // Applicant logins for the candidate portal (M4).
  candidateAccounts CandidateAccount[]
  // Compliance (ATS M10).
  eeoResponses    EeoResponse[]
  erasureRequests ErasureRequest[]
  // Compliance (ATS M12): the audit trail for EEO exports.
  eeoExportLogs   EeoExportLog[]
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  role               Role      @default(EMPLOYEE)
  isSystemUser       Boolean   @default(false)
  // bcrypt hash for the Credentials login. Nullable: the SYSTEM user and any
  // future SSO-only users won't have a local password.
  passwordHash       String?
  // Nullable now so a real auth provider (Auth.js) can populate it later. Doubles as the
  // "account activated" marker: null until the new hire sets their password via an invite.
  emailVerifiedAt    DateTime?
  // New-hire invite: a one-time link lets an employee set their first password. We store the
  // SHA-256 HASH of the random token (never the token itself), so a DB leak yields no usable
  // link. Cleared once the password is set. inviteTokenExpires bounds the link's lifetime.
  inviteTokenHash    String?   @unique
  inviteTokenExpires DateTime?
  invitedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // A login identity optionally maps to exactly one employee record.
  employee Employee?

  // Back-relations for the columns that record "who did this".
  historyChanges         EmployeeHistory[]      @relation("HistoryChangedBy")
  auditActions           EmployeeAuditLog[]     @relation("AuditActor")
  uploadedDocs           EmployeeDocument[]     @relation("DocUploadedBy")
  departmentsHead        Department[]           @relation("DepartmentHead")
  statusChanges          EmployeeStatusChange[] @relation("StatusChangeActor")
  // Time-management (PTO): who FILED a request, who REVIEWED it, and who created a ledger entry.
  leaveRequestsFiled     LeaveRequest[]         @relation("LeaveRequestFiledBy")
  leaveRequestsReviewed  LeaveRequest[]         @relation("LeaveRequestReviewedBy")
  leaveLedgerEntries     LeaveLedgerEntry[]     @relation("LeaveLedgerCreatedBy")
  timesheetsReviewed     Timesheet[]            @relation("TimesheetReviewedBy")
  shiftsCreated          Shift[]                @relation("ShiftCreatedBy")
  swapsReviewed          ShiftSwapRequest[]     @relation("SwapReviewedBy")
  // Attendance: who recorded a punch (the employee for self-punches, or an HR/manager for a correction).
  clockEventsRecorded    ClockEvent[]           @relation("ClockRecordedBy")
  // Projects: who created a project, and who made an assignment.
  projectsCreated        Project[]              @relation("ProjectCreatedBy")
  projectAssignmentsMade ProjectAssignment[]    @relation("ProjectAssignedBy")
  // Meetings (M10): who created a recurring meeting, and who made an assignment.
  meetingsCreated        Meeting[]              @relation("MeetingCreatedBy")
  meetingAssignmentsMade MeetingAssignment[]    @relation("MeetingAssignedBy")
  // Recruiting (ATS, M1): who created a job/req, who added a hiring-team member, who acted on an application.
  jobsCreated            Job[]                  @relation("JobCreatedBy")
  jobMembersAdded        JobMember[]            @relation("JobMemberAddedBy")
  applicationEvents      ApplicationEvent[]     @relation("ApplicationEventActor")
  notificationsReceived  NotificationDelivery[] @relation("NotificationRecipient")
  interviewSlotsProposed InterviewSlot[]        @relation("InterviewSlotProposedBy")
  // Compliance (ATS M12): EEO exports this user produced.
  eeoExports             EeoExportLog[]         @relation("EeoExportActor")
  // Compensation (ATS M14): who wrote an offer.
  offersCreated          Offer[]                @relation("OfferCreatedBy")
  // Attribution (ATS M2, applicant-app track): who opened a recruitment campaign.
  campaignsCreated       Campaign[]             @relation("CampaignCreatedBy")

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Employee records
// ---------------------------------------------------------------------------

model Employee {
  id                String           @id @default(uuid())
  employeeNumber    String
  firstName         String
  lastName          String
  email             String
  employmentStatus  EmploymentStatus @default(ACTIVE)
  hireDate          DateTime
  terminationDate   DateTime?
  terminationReason String? // free-text circumstances of dismissal
  eligibleForRehire Boolean          @default(true) // set at termination; gates rehire
  rehireDate        DateTime?
  location          String? // plain string for now (e.g. "Mexico City, MX"); promote to a Location model later
  // Current-state descriptive fields (NOT versioned — a phone number changing isn't a dated
  // career event). Edited via the correction flow; never overwrite the history timeline.
  phone             String?
  workSchedule      String? // free text for now, e.g. "Mon-Fri, 09:00-18:00"
  timeZone          String? // IANA name, e.g. "America/Mexico_City"
  // Review dates + equity are comp-sensitive current-state: shown only inside the gated
  // Compensation card, conditionally selected only when the viewer can see compensation.
  lastReviewDate    DateTime?
  nextReviewDate    DateTime?
  equityNote        String? // free text, e.g. "4-yr cliff 1"
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // One employee is one login identity.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // Self-referential manager link — this is what powers the org chart.
  managerId String?
  manager   Employee?  @relation("OrgHierarchy", fields: [managerId], references: [id])
  reports   Employee[] @relation("OrgHierarchy")

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  history                 EmployeeHistory[]
  documents               EmployeeDocument[]
  auditLogs               EmployeeAuditLog[]
  emergencyContacts       EmergencyContact[]
  statusChanges           EmployeeStatusChange[]
  leaveRequests           LeaveRequest[]
  leaveLedger             LeaveLedgerEntry[]
  timesheets              Timesheet[]
  timeEntries             TimeEntry[]
  shifts                  Shift[]
  swapsRequested          ShiftSwapRequest[]     @relation("SwapRequestedBy")
  swapsTargeted           ShiftSwapRequest[]     @relation("SwapTarget")
  clockEvents             ClockEvent[]
  projectAssignments      ProjectAssignment[]
  meetingAssignments      MeetingAssignment[]
  jobMemberships          JobMember[]
  scorecardsAuthored      Scorecard[]            @relation("ScorecardAuthor")
  interviewSlots          InterviewSlot[]        @relation("InterviewSlotInterviewer")
  // The ATS application this person was hired from, if they came through recruiting (M8).
  hiredFromApplication    Application?           @relation("ApplicationHire")
  // Compliance (ATS M10): the erasures this person carried out, and the requests they resolved.
  candidatesAnonymised    Candidate[]            @relation("CandidateAnonymisedBy")
  erasureRequestsResolved ErasureRequest[]       @relation("ErasureResolvedBy")
  // Retention (ATS M11): candidates this person archived by hand (the sweep leaves this null).
  candidatesArchived      Candidate[]            @relation("CandidateArchivedBy")
  // Great leads (ATS M16): candidates this person flagged as worth revisiting.
  candidatesMarkedAsLeads Candidate[]            @relation("CandidateLeadMarkedBy")

  // Employee numbers are unique within an organization, not globally.
  @@unique([orgId, employeeNumber])
  @@index([managerId])
  @@index([departmentId])
}

// Temporal table (Slowly Changing Dimension, Type 2).
// One row per version of the versioned fields. The CURRENT version has
// effectiveTo = null. Invariant: exactly one open row per employee.
model EmployeeHistory {
  id                 String              @id @default(uuid())
  version            Int
  jobTitle           String
  // Denormalized snapshots: the label AS IT WAS at effectiveFrom, so renaming or
  // deleting a department/manager later cannot rewrite history.
  departmentSnapshot String
  managerSnapshot    String?
  employmentType     EmploymentType
  salary             Decimal             @db.Decimal(12, 2) // money is never a float
  currency           String              @default("USD")
  // Versioned comp/role attributes. Nullable so pre-existing history rows migrate without a
  // backfill guess; every new version (create/change) sets them. flsa + payFrequency render in
  // the (ungated) Employment card; payBasis pairs with salary in the gated Compensation card.
  flsaClassification FlsaClassification?
  payFrequency       PayFrequency?
  payBasis           PayBasis?
  changedFields      Json // which fields changed in this version, e.g. ["salary","jobTitle"]
  changeReason       String?
  effectiveFrom      DateTime
  effectiveTo        DateTime? // null = current version
  // When this row was ENTERED (distinct from effectiveFrom). Anchors the 7-day
  // correction grace window: material fields can be corrected in place until this ages out.
  createdAt          DateTime            @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  changedById String
  changedBy   User   @relation("HistoryChangedBy", fields: [changedById], references: [id])

  @@unique([employeeId, version])
  @@index([employeeId, effectiveFrom])
}

// A leave or suspension SPAN. One row per occurrence, retained forever (repeat occurrences
// accumulate — "has this happened before?" is answerable directly). endDate = null means the
// span is still open; reinstate closes it. Distinct from EmployeeHistory: status is NOT a
// versioned field (a suspended employee keeps their title/salary), so this never touches the
// timeline. RLS-gated by app_can_see_employee, so a manager sees their reports' records.
model EmployeeStatusChange {
  id          String           @id @default(uuid())
  type        StatusChangeType
  reason      String
  startDate   DateTime
  expectedEnd DateTime? // optional planned return (leave); suspensions are often open-ended
  endDate     DateTime? // null = ongoing; set to the return date on reinstate
  createdAt   DateTime         @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdById String
  createdBy   User   @relation("StatusChangeActor", fields: [createdById], references: [id])

  @@index([employeeId, startDate])
}

// ---------------------------------------------------------------------------
// Time-management (PTO) — apps/time-management, M1.
// ---------------------------------------------------------------------------

// An employee-initiated (or HR-filed) request for time off. RLS-gated by app_can_see_employee,
// so an employee sees their own, a manager their reports', HR all. The row IS the request record;
// the human decisions on it are also written to EmployeeAuditLog for the compliance trail.
model LeaveRequest {
  id           String             @id @default(uuid())
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  hours        Decimal            @db.Decimal(6, 2) // total requested hours (business days × workday)
  status       LeaveRequestStatus @default(PENDING)
  reason       String? // optional note from the requester
  decisionNote String? // optional note from the approver/denier
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Who FILED the request — the employee themselves, or an HR user acting on their behalf.
  createdById String
  createdBy   User   @relation("LeaveRequestFiledBy", fields: [createdById], references: [id])

  // Who approved/denied it (null while PENDING).
  reviewedById String?
  reviewedBy   User?   @relation("LeaveRequestReviewedBy", fields: [reviewedById], references: [id])

  // USAGE / REVERSAL ledger rows generated by approving / cancelling this request.
  ledgerEntries LeaveLedgerEntry[]

  @@index([employeeId, startDate])
}

// One signed entry in an employee's leave balance ledger. Balance for (employee, type) = SUM(hours).
// Same RLS as LeaveRequest. Never mutated after write (append-only by convention; the ledger is the
// audit trail for "why is my balance X?").
model LeaveLedgerEntry {
  id            String            @id @default(uuid())
  type          LeaveType
  hours         Decimal           @db.Decimal(7, 2) // signed: + accrual/opening/reversal, − usage
  source        LeaveLedgerSource
  note          String?
  effectiveDate DateTime
  // Set ONLY for ACCRUAL rows, e.g. "2026-07". The unique index below makes monthly accrual
  // idempotent (re-running a period is a no-op). NULL for every other source — and Postgres
  // treats NULLs as distinct in a UNIQUE index, so non-accrual entries are never constrained.
  accrualPeriod String?
  createdAt     DateTime          @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // The request that caused this row (USAGE / REVERSAL). Null for OPENING / ACCRUAL / ADJUSTMENT.
  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])

  createdById String
  createdBy   User   @relation("LeaveLedgerCreatedBy", fields: [createdById], references: [id])

  @@unique([employeeId, type, accrualPeriod])
  @@index([employeeId, type])
}

// Org-scoped accrual configuration, one row per (org, leave type). NOT employee-scoped, so no RLS
// (like Department); writes are gated app-side to HR_ADMIN. Drives the automatic accrual engine.
model LeavePolicy {
  id                   String    @id @default(uuid())
  type                 LeaveType
  accrualHoursPerMonth Decimal   @db.Decimal(6, 2)
  maxBalanceHours      Decimal?  @db.Decimal(7, 2) // cap; null = uncapped. Accrual stops at the cap.
  accrues              Boolean   @default(true) // UNPAID → false (no balance tracking)
  updatedAt            DateTime  @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, type])
}

// A weekly (Mon–Sun) timesheet — the submittable/approvable unit. One per employee per week. Same
// RLS as the leave tables. Overtime is DERIVED from the entries at read time (never stored), so it
// can't drift; the FLSA classification that decides OT eligibility is read from the employee's open
// EmployeeHistory row.
model Timesheet {
  id           String          @id @default(uuid())
  periodStart  DateTime // Monday (UTC midnight)
  periodEnd    DateTime // Sunday
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  decisionNote String? // reviewer's note on approve/reject
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("TimesheetReviewedBy", fields: [reviewedById], references: [id])

  entries TimeEntry[]

  @@unique([employeeId, periodStart])
  @@index([employeeId, status])
}

// One line of worked hours on a timesheet. employeeId is denormalized (from the parent Timesheet)
// so the RLS policy is the same one-liner as every other employee-scoped table. The UI edits one
// row per day; the model stays open to per-project splits (the OT math sums per day either way).
model TimeEntry {
  id        String   @id @default(uuid())
  workDate  DateTime // the calendar day (UTC midnight)
  hours     Decimal  @db.Decimal(5, 2)
  note      String?
  createdAt DateTime @default(now())

  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Optional project tag (assignment-based — the employee picks from projects they're assigned to).
  // SetNull so archiving/removing a project never destroys the hours logged against it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Optional recurring-meeting tag (M10). A line is tagged a project OR a meeting OR neither — the
  // "not both" rule is enforced in the Zod schema, not the DB. SetNull like project: archiving or
  // removing a meeting never destroys the hours logged against it.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([timesheetId])
  @@index([employeeId, workDate])
  @@index([projectId])
  @@index([meetingId])
}

// A scheduled shift on a department's roster. `employeeId` null = an OPEN (unfilled) shift. Visibility
// is DEPARTMENT-scoped, not employee-scoped: a PUBLISHED shift is visible to everyone in the
// department (the posted schedule), while drafts are only the dept's manager + HR — enforced by the
// app_can_see_shift RLS policy (the one place the suite loosens "employee sees only self"). Times are
// stored as UTC timestamps built from a date + wall-clock time (real per-location tz deferred).
model Shift {
  id        String   @id @default(uuid())
  startAt   DateTime
  endAt     DateTime
  role      String? // position label, e.g. "Front desk"
  note      String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Null = open shift (a coverage gap the manager can fill).
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdById String
  createdBy   User   @relation("ShiftCreatedBy", fields: [createdById], references: [id])

  swapRequests ShiftSwapRequest[]

  @@index([departmentId, startAt])
  @@index([employeeId])
}

// An employee's request to DROP their shift (→ open) or SWAP it with a named colleague. The manager
// approves/denies (reassigning the shift). RLS'd by app_can_see_employee(requestedByEmployeeId), so
// the requester's manager (subtree) + HR see it — same as leave/timesheets.
model ShiftSwapRequest {
  id           String          @id @default(uuid())
  reason       String?
  status       ShiftSwapStatus @default(PENDING)
  decisionNote String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  requestedByEmployeeId String
  requestedBy           Employee @relation("SwapRequestedBy", fields: [requestedByEmployeeId], references: [id])

  // Null = drop-to-open; otherwise the colleague to swap the shift to.
  targetEmployeeId String?
  target           Employee? @relation("SwapTarget", fields: [targetEmployeeId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("SwapReviewedBy", fields: [reviewedById], references: [id])

  @@index([requestedByEmployeeId, status])
}

// A single clock punch (IN or OUT) — the attendance event ledger (M4). This is the sole source of
// truth: worked hours, sessions, and schedule variance (late / short / absent) are all DERIVED by
// pairing punches at read time, never stored, so there is no summary row to keep in sync. Visibility
// is the standard employee-scope (app_can_see_employee on employeeId) — own / manager-subtree / HR.
model ClockEvent {
  id        String         @id @default(uuid())
  at        DateTime // the punch instant (UTC)
  type      ClockEventType
  source    ClockSource    @default(WEB)
  note      String? // correction reason (MANUAL punches)
  createdAt DateTime       @default(now())

  // The subject of the punch. Denormalized owner column so the RLS policy is the same one-liner as
  // every other employee-scoped table.
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Who actually recorded it: the employee for a self-punch, or an HR/manager for a MANUAL correction.
  createdById String
  createdBy   User   @relation("ClockRecordedBy", fields: [createdById], references: [id])

  @@index([employeeId, at])
}

// A project employees can log time against (M8). Assignment-based: a manager (or HR) creates a project
// and assigns specific employees to it via ProjectAssignment; an employee only sees projects they're
// assigned to. Org-scoped config (NO RLS — like Department/LeavePolicy); visibility for the picker is
// enforced through the RLS'd assignment join, and management is app-gated (creator + HR).
model Project {
  id        String        @id @default(uuid())
  name      String
  code      String? // optional short code, e.g. "PLAT" (displayed monospaced)
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  assignments ProjectAssignment[]
  entries     TimeEntry[]

  @@index([orgId, status])
}

// Which employees may log time to which project. RLS'd by app_can_see_employee(employeeId) — an
// employee sees their own assignments, a manager their subtree's, HR all — so the picker and the
// manager's assignment editor are both scoped for free.
model ProjectAssignment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedById String
  assignedBy   User   @relation("ProjectAssignedBy", fields: [assignedById], references: [id])

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

// A recurring weekly meeting employees can log time against (M10). The hybrid of scheduling + time
// tracking: a manager (or HR) programs a meeting at a weekday + time (like a lightweight recurring
// shift) and assigns employees via MeetingAssignment; on the timesheet it surfaces as a selectable
// activity with a suggested duration. Like Project, it's org-scoped config with NO RLS — visibility
// for the picker flows through the RLS'd assignment join, and management is app-gated (creator + HR).
model Meeting {
  id        String        @id @default(uuid())
  name      String
  // 0 = Sunday … 6 = Saturday (JS Date.getUTCDay convention, matching how the grid resolves weekdays).
  dayOfWeek Int
  startTime String // "HH:MM" wall-clock (UTC, same convention as Shift start/end times)
  endTime   String // "HH:MM"
  status    MeetingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdById String
  createdBy   User   @relation("MeetingCreatedBy", fields: [createdById], references: [id])

  assignments MeetingAssignment[]
  entries     TimeEntry[]

  @@index([orgId, status])
}

// Which employees may log time to which meeting. RLS'd by app_can_see_employee(employeeId) — an
// employee sees their own assignments, a manager their subtree's, HR all — so the timesheet picker
// and the manager's assignment editor are both scoped for free (mirrors ProjectAssignment).
model MeetingAssignment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedById String
  assignedBy   User   @relation("MeetingAssignedBy", fields: [assignedById], references: [id])

  @@unique([meetingId, employeeId])
  @@index([employeeId])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // Self-referential for sub-departments of arbitrary depth.
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentTree", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[] @relation("DepartmentTree")

  headUserId String?
  head       User?   @relation("DepartmentHead", fields: [headUserId], references: [id])

  employees Employee[]
  // Budget lives in its own RLS-protected table so it can't be read without passing the
  // access policy — see DepartmentBudget.
  budgetRow DepartmentBudget?
  shifts    Shift[]
  jobs      Job[]

  @@index([orgId])
  @@index([parentDepartmentId])
}

// The department budget, isolated into its own table so Row-Level Security can gate it.
// RLS on this table (policy: app_can_see_budget) is the DB-level wall; the app-layer
// canViewBudget() is now only a UI hint. Also a natural home for budget history later.
model DepartmentBudget {
  departmentId String     @id
  department   Department @relation(fields: [departmentId], references: [id])
  budget       Decimal    @db.Decimal(14, 2)
  updatedAt    DateTime   @updatedAt
}

model EmployeeDocument {
  id            String       @id @default(uuid())
  documentType  DocumentType
  fileName      String
  // Object key (e.g. S3/R2), NOT a public URL. Download links are short-lived
  // signed URLs generated server-side at request time.
  fileUrl       String
  fileSizeBytes Int
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("DocUploadedBy", fields: [uploadedById], references: [id])

  @@index([employeeId])
}

// Append-only compliance log. UPDATE/DELETE are revoked from the app role at the
// DB level (see the audit_append_only migration). occurredAt is DB-defaulted so
// the application can never backdate an event.
model EmployeeAuditLog {
  id          String         @id @default(uuid())
  eventType   AuditEventType
  actorType   ActorType      @default(USER)
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  occurredAt  DateTime       @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  @@index([employeeId, occurredAt])
}

model EmergencyContact {
  id           String  @id @default(uuid())
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// Global key-value app config (e.g. storageDir). Not sensitive → no RLS; writes are
// gated in app code (HR_ADMIN via canManageSettings).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Recruiting (ATS) — apps/ats, M1. Visibility is the per-job hiring TEAM: recruiters + HR see all
// reqs org-wide; everyone else sees a job (and its candidates/applications) only if they're on its
// JobMember team. Enforced by app_can_see_job / app_can_manage_job (custom SECURITY DEFINER fns with
// a read/write policy split, mirroring the Shift design). See the add_recruiting migration.
// ---------------------------------------------------------------------------

// A job requisition. Org-scoped; management gated to the job's hiring managers + recruiters/HR.
model Job {
  id             String          @id @default(uuid())
  title          String
  description    String?
  location       String?
  employmentType EmploymentType  @default(FULL_TIME)
  status         JobStatus       @default(DRAFT)
  openings       Int             @default(1)
  // When this req was POSTED PUBLICLY. null = not advertised — a job can be OPEN internally without
  // appearing on the careers site (confidential backfills, exec searches). A nullable timestamp
  // rather than a boolean: it carries the same yes/no plus the "posted on" date the listing shows.
  // The public apply path refuses any job that isn't OPEN *and* published.
  publishedAt    DateTime?
  // EEO-1 job category (M12). NULLABLE and deliberately never defaulted: guessing a category would
  // silently mis-file a regulatory return, so an unset one is surfaced as a warning on the filing
  // export instead of being quietly bucketed somewhere plausible.
  eeoJobCategory EeoJobCategory?

  // ── The screening call window (M13) ───────────────────────────────────────────────────────
  //
  // When this req's recruiters make screening calls, shown to an applicant sitting at SCREEN so
  // they know when to be reachable. Nobody self-books: the recruiter calls, and this is the promise.
  //
  // ⚠️ "HH:MM" STRINGS, NOT TIMESTAMPS — the one place `Meeting`'s idiom beats `Shift`'s, which is
  // the exact reverse of what InterviewSlot argues below. A slot is a specific instant, so it stores
  // real DateTimes. This is a RECURRING WALL CLOCK with no date ("we call between 9 and 5"), and a
  // timestamp would have to invent a day — the very thing nobody has committed to yet.
  //
  // ⚠️ ALL THREE OR NONE, and the DATABASE enforces it (`Job_screening_call_window_ck`, which also
  // pins the "HH:MM" format and requires from < to). Prisma cannot express a CHECK, so it is
  // invisible here and lives in the migration — verified with `migrate diff` to produce no drift.
  // A half-set window is the one state that renders an instruction nobody can follow.
  screeningCallFrom     String?
  screeningCallTo       String?
  // The IANA zone the two wall clocks are read in. Not decoration: "9:00" means nothing to a
  // candidate abroad without it, so it is rendered beside the hours everywhere they appear.
  screeningCallTimeZone String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // Optional hiring department (some reqs aren't tied to a dept yet).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  interviewRounds   InterviewRound[]
  members           JobMember[]
  applications      Application[]
  applicationEvents ApplicationEvent[] @relation("ApplicationEventJob")
  notificationDeliveries NotificationDelivery[] @relation("NotificationDeliveryJob")
  interviewSlots         InterviewSlot[]        @relation("InterviewSlotJob")
  competencies      JobCompetency[]
  scorecards        Scorecard[]        @relation("ScorecardJob")
  eeoResponses      EeoResponse[]      @relation("EeoResponseJob")
  // Compensation (M14). The band is a SEPARATE table, not columns here, because this row is
  // readable by the whole hiring team — interviewers included — and RLS cannot hide a column.
  salaryBand        SalaryBand?
  offers            Offer[]            @relation("OfferJob")
  consents          ApplicationConsent[] @relation("ApplicationConsentJob")
  questions         JobQuestion[]
  answers           ApplicationAnswer[]  @relation("ApplicationAnswerJob")

  @@index([orgId, status])
}

// A configurable interview round inside a job's INTERVIEW phase (the per-job "form"). Ordered by
// position. An Application in INTERVIEW points at the round it's currently in (Application.currentRoundId).
model InterviewRound {
  id        String   @id @default(uuid())
  name      String
  position  Int
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  applications Application[]
  scorecards   Scorecard[]
  slots        InterviewSlot[]

  @@unique([jobId, position])
  @@index([jobId])
}

// A bookable interview time (M9) — the thing `InterviewRound` never had. A round is a NAME and an
// order; this is when it actually happens, with whom.
//
// ⚠️ FOLLOWS `Shift`, NOT `Meeting`. Shift stores real `startAt`/`endAt` instants plus a published
// flag and a nullable assignee — which is almost exactly a slot. `Meeting` stores `"HH:MM"` with a
// `dayOfWeek` because it is a weekly RECURRENCE: it cannot express "Tuesday 3 March" at all, and a
// wall-clock string means whatever the reader's frame says it means. Fine for one org's staff;
// ambiguous to a candidate abroad, who would arrive at the right number and the wrong moment.
//
// ⚠️ A SHARED POOL PER (job, round), NOT PER APPLICATION. Several candidates can be looking at the
// same times, which is why claiming is an atomic conditional UPDATE in a doorway
// (app_claim_interview_slot) and never a read-then-write.
//
// ⚠️ NO FREE-TEXT NOTE FIELD, DELIBERATELY. A note is exactly where someone would write something
// about the candidate, and its absence is what keeps this table free of personal data — so
// app_erase_candidate does not touch it, and a claimed slot survives an erasure the way stages and
// ratings do. If a note is ever added, it arrives WITH its erasure handling.
model InterviewSlot {
  id String @id @default(uuid())

  // An absolute instant. `timeZone` is the IANA zone it was SET in — kept so the canonical rendering
  // can name it ("15:00 America/Mexico_City"), which is the only unambiguous thing to show someone
  // whose own zone we do not know. It is a label for display, never the source of truth for when.
  startAt  DateTime
  endAt    DateTime
  timeZone String

  // Video link or room. Optional: some interviews are a phone call arranged separately.
  meetingUrl String?

  // ── The lifecycle, as nullable timestamps rather than a status enum ────────────────────────────
  // Same idiom as Candidate.archivedAt / anonymisedAt / leadMarkedAt: every step reverses by setting
  // NULL, and WHEN each happened survives — which one enum column would throw away. The derived
  // status is a pure function in @hris/recruiting, where it is testable without a database.
  //
  //   proposed (row exists) → confirmedAt → publishedAt → claimedAt
  //
  // Nothing is visible to a candidate before `publishedAt`, so an unconfirmed proposal cannot leak a
  // date to the person it concerns.
  confirmedAt DateTime?
  publishedAt DateTime?
  claimedAt   DateTime?
  // Cancelling RELEASES the claim (claimedAt + claimedByApplicationId back to NULL), so the
  // candidate can be rebooked for that round — see the unique constraint below.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalized owner column, so the RLS policy is the same one-liner as every other scoped table.
  jobId String
  job   Job    @relation("InterviewSlotJob", fields: [jobId], references: [id], onDelete: Cascade)

  // Required: the pool is per (job, round). A slot without a round has no meaning, and Cascade
  // because a deleted round's times are equally meaningless.
  roundId String
  round   InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // The person who has to CONFIRM it, and then sit in it. They are typically a JobMember with role
  // INTERVIEWER — who can see the req but NOT manage it, which is why confirming needs its own gate
  // (app_can_confirm_interview_slot) rather than the ordinary write policy.
  interviewerEmployeeId String
  interviewer           Employee @relation("InterviewSlotInterviewer", fields: [interviewerEmployeeId], references: [id])

  proposedById String
  proposedBy   User   @relation("InterviewSlotProposedBy", fields: [proposedById], references: [id])

  claimedByApplicationId String?
  claimedByApplication   Application? @relation(fields: [claimedByApplicationId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  // ⚠️ THE ONCE-PER-ROUND RULE, ENFORCED IN THE DATABASE. An application may hold at most one slot
  // per round — it may hold one for round 1 AND one for round 2, which is why the constraint is the
  // PAIR and not the application alone (that would block round 2 forever).
  //
  // Unclaimed slots have a NULL applicationId and Postgres treats NULLs as DISTINCT here, so any
  // number of them coexist — which is exactly right, and the one place in this schema where the
  // DEFAULT null behaviour is the one we want (contrast NotificationDelivery, which needs
  // NULLS NOT DISTINCT). M11 relies on this: it is what makes "you may pick exactly once" a
  // constraint rather than a promise in application code.
  @@unique([claimedByApplicationId, roundId])
  @@index([jobId, startAt])
  @@index([interviewerEmployeeId])
}

// A member of a job's hiring team + their role on it — the join that powers the ATS access model.
// RLS: readable if you can SEE the job, writable if you can MANAGE it.
model JobMember {
  id        String        @id @default(uuid())
  role      JobMemberRole
  createdAt DateTime      @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  addedById String
  addedBy   User   @relation("JobMemberAddedBy", fields: [addedById], references: [id])

  @@unique([jobId, employeeId])
  @@index([employeeId])
}

// A candidate (a person). Deduped by email within an org — one Candidate has many Applications, so
// their history across reqs is visible. PII is ANONYMISED on request (GDPR right to erasure, M10)
// rather than hard-deleted — the deliberate inverse of the employee "never delete" rule, because the
// obligation follows the RELATIONSHIP: an applicant is not an employee, and only the employment
// relationship carries a retention duty that outranks the right to be forgotten.
// ── The applicant's PROFILE (M6) ───────────────────────────────────────────────────────────────
//
// One work history per person, maintained by them, reused every time they apply. The immutable
// record of what any given application carried lives on Application.employmentSnapshot — see there
// for why the two exist together.
//
// ⚠️ ENTIRELY PII, INCLUDING ABOUT THIRD PARTIES. An employer name plus dates identifies where
// someone worked and when; a "reason for leaving" would say more still. app_erase_candidate DELETES
// these rows rather than blanking them: with the person erased, nothing here is a fact about our
// process worth keeping.
model CandidateEmployment {
  id        String    @id @default(uuid())
  employer  String
  title     String
  // Month precision is enough for a CV and asks for less than a full date does.
  startDate DateTime
  // NULL means "still there" — the ordinary state of a current job, not missing data.
  endDate   DateTime?
  summary   String?
  // Display order the applicant chose; newest-first is their job to decide, not ours to infer.
  position  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, position])
}

model CandidateEducation {
  id           String    @id @default(uuid())
  institution  String
  qualification String
  startDate    DateTime?
  endDate      DateTime?
  position     Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, position])
}

// Proof that consent was given, for one application, under a named policy version (M6).
//
// ⚠️ THIS TABLE HOLDS NO PERSONAL DATA, AND THAT IS THE WHOLE DESIGN. No name, no email, no IP —
// a version string, a timestamp and a link. Which is why it is the one applicant-facing table that
// app_erase_candidate does NOT touch: after an erasure it attaches to a shell and says "consent was
// given for this application under policy v…", proving the processing we did was lawful without
// describing anyone. Destroying it would delete the evidence and keep nothing.
//
// The version is a constant in @hris/recruiting, not a row here: it changes when the policy TEXT
// changes, and that text lives in code.
model ApplicationConsent {
  id            String   @id @default(uuid())
  policyVersion String
  acceptedAt    DateTime @default(now())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Denormalized so the RLS policy is the same one-liner as every other job-scoped table, without
  // joining an RLS-protected table from inside a policy — same reasoning as EeoResponse.jobId.
  jobId String
  job   Job    @relation("ApplicationConsentJob", fields: [jobId], references: [id])

  @@index([jobId])
}

// A screening question attached to ONE requisition (M6b) — "Are you authorised to work here?",
// "What is your notice period?". Same shape as JobCompetency: an ordered child of Job, cascade-
// deleted with it, defined by whoever manages the req.
//
// ⚠️ NO @@unique([jobId, position]), UNLIKE JobCompetency and InterviewRound. Those are never
// archived, so their positions stay dense and the constraint is free. Questions ARE archived, which
// leaves gaps and makes every insert-in-the-middle a shuffle needing a temporary value to dodge the
// constraint. An index gives the ordering without the ceremony.
model JobQuestion {
  id       String       @id @default(uuid())
  prompt   String
  type     QuestionType
  required Boolean      @default(false)
  // Only meaningful for SINGLE_SELECT. A Postgres text[] rather than a child table: the options ARE
  // the question, they are never queried independently, and a table would need its own ordering,
  // its own policy and its own erasure consideration for no gain.
  options  String[]     @default([])
  position Int
  // Retire a question without destroying what people already answered — the same reversible
  // timestamp as Campaign.archivedAt. An archived question stops being ASKED; its answers stay.
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  answers ApplicationAnswer[]

  @@index([jobId, position])
}

// One applicant's answer to one question (M6b).
//
// ⚠️ `promptSnapshot` IS NOT REDUNDANT. It records the question AS ASKED. Reword a question next
// quarter and every past answer would otherwise appear to respond to the new wording — the same
// failure ApplicationEvent.roundName, Application.source and M6's history snapshots all exist to
// prevent. The FK answers "which question is this", the snapshot answers "what were they asked".
//
// ⚠️ ENTIRELY THE PERSON'S OWN WORDS. app_erase_candidate DELETES these rows; an emptied row saying
// "they answered something" preserves nothing worth keeping.
model ApplicationAnswer {
  id             String   @id @default(uuid())
  promptSnapshot String
  value          String
  createdAt      DateTime @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // SetNull so hard-deleting a question (which the UI does not offer — it archives) can never
  // destroy an answer.
  questionId String?
  question   JobQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  // Denormalized so the RLS policy stays the same one-liner as every other job-scoped table, without
  // joining an RLS-protected table from inside a policy. Same trick as EeoResponse.jobId.
  jobId String
  job   Job    @relation("ApplicationAnswerJob", fields: [jobId], references: [id])

  @@unique([applicationId, questionId])
  @@index([jobId])
}

// An applicant's LOGIN to the candidate portal (app 4) — the suite's first non-employee identity.
//
// ⚠️ DELIBERATELY NOT A `User` WITH A NEW `Role`. Every staff gate in this system is an allow-list
// (`role IN (…)` in the RLS helpers, `ALL_RECORDS_ROLES`/`isRecruiter` in roles.ts), so a new enum
// value would fail closed — but "fails closed today" is a property of code that can change, whereas
// a separate table makes "an applicant cannot hold a staff session" true by construction. It also
// sidesteps a real collision: `User.email` is globally unique while `Candidate.email` is unique
// PER ORG, so an employee applying to an internal req would clash.
//
// ⚠️ THERE IS NO EMAIL COLUMN HERE, AND NO PASSWORD. Both absences are the design:
//   • The login address is `candidate.email` — one source of truth, nothing to drift. It also means
//     app_erase_candidate's existing email scramble instantly makes an erased person unreachable by
//     their old address, before this table is even considered.
//   • Login is passwordless (a one-time emailed link), so there is no hash to leak, no reset flow to
//     abuse, and no password for someone to reuse from another breach.
//
// What's left holds NO personal data at all — an id, a token hash, timestamps. That is precisely
// what makes it safe for this table to sit OUTSIDE RLS, exactly like `User`: the auth flow has to
// read it BEFORE any session exists, so a policy keyed on session variables could never match.
model CandidateAccount {
  id String @id @default(uuid())

  // SHA-256 of a 256-bit random token — never the token itself, so a database leak yields no usable
  // link. @unique both to enforce one live link per account and to make redemption an index hit.
  // Cleared on redemption: that is what makes a link single-use.
  loginTokenHash    String?   @unique
  loginTokenExpires DateTime?
  lastLoginAt       DateTime?

  // Set when this person is HIRED. Their record belongs to the employee system from then on, and
  // the internet-facing portal stops being a door into their interview and offer history. Written
  // by app_link_hire, in the same statement that records the hire — see that function.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // One account per candidate, and the account cannot outlive the person's record.
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// A named recruitment campaign — the fine-grained half of attribution (M2).
//
// WHY A TABLE AND AN ENUM, not one or the other. The enum (SourceChannel) is what /reports rolls up
// on, and a roll-up needs a vocabulary that cannot drift. But "LinkedIn" alone cannot answer which
// LinkedIn PUSH worked, and recruiters must be able to start a campaign without a deploy. So the
// campaign is the row they create; the channel is the fixed axis it reports under.
//
// `slug` is the value that appears in a tracking URL (?source=<slug>) and it is the ONLY thing the
// public apply path will accept. It is unique per org and validated to [a-z0-9-] so it can never
// carry a path fragment, a name, or anything else a stranger fancied typing.
//
// ⚠️ THIS TABLE HOLDS NO PERSONAL DATA, and that is deliberate rather than incidental — it is what
// lets attribution outlive an erasure. `name` is a channel label ("LinkedIn — March grads"), never
// a person. A campaign named after the individual who referred someone would put a name into a
// figure that survives app_erase_candidate, which is exactly the leak leadNote is warned about.
model Campaign {
  id         String        @id @default(uuid())
  name       String // display label, e.g. "LinkedIn — March grads"
  slug       String // the ?source= value; lowercase, [a-z0-9-]
  channel    SourceChannel
  // Retire a campaign without destroying what it produced — the same nullable-timestamp idiom as
  // Candidate.archivedAt, and for the same reason: reversible, and it keeps the history intact.
  // An archived campaign's slug STOPS being accepted by the public apply path.
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdById String
  createdBy   User   @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  applications Application[]

  @@unique([orgId, slug])
  @@index([orgId, archivedAt])
}

model Candidate {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  // FIRST TOUCH — how this person first entered our world, e.g. "Referral". NOT the attribution for
  // any particular application: that lives on Application.source, because someone who applied via
  // the careers page in March and a LinkedIn campaign in August is two attributions, not one. The
  // two are different questions and both are worth answering, which is why this column survived the
  // move. app_submit_application fills it with COALESCE (gaps only, never overwritten), which is
  // exactly what "first" means.
  source         String?
  // Object-storage key for the resume (like EmployeeDocument.fileUrl) — never a public URL.
  resumeKey      String?
  resumeFileName String?
  // THE LANGUAGE WE WRITE TO THEM IN (M8).
  //
  // ⚠️ IT HAS TO LIVE ON THE PERSON, and this is not a preference feature. Locale everywhere else in
  // the suite is read from a COOKIE ON THE CURRENT REQUEST (packages/ui/src/server/i18n.server.js) —
  // which is correct while someone is browsing, and completely wrong for an email. A stage-change
  // notification is triggered by a RECRUITER's request, so `getT()` there yields the recruiter's
  // language; a cron job has no request at all and silently yields "en". Either way the candidate
  // gets a message in someone else's language, and it looks fine in development because everyone is
  // testing in English.
  //
  // Captured at APPLY time, gap-filled with COALESCE like `phone` and `source` — first touch wins.
  // Both apply paths are public pages, so the visitor's own cookie is authoritative there; it is the
  // only moment in the whole flow when it is. NULL falls back to "en" at render time.
  locale         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Erasure (M10) ─────────────────────────────────────────────────────────────────────────────
  // Set once this person's personal data has been destroyed. The row itself survives as a SHELL so
  // every historical count still balances (see app_erase_candidate). These three columns ARE the
  // audit trail — who erased, when, and why — which is why no separate log table exists: the record
  // of the erasure must live exactly as long as the thing it explains.
  anonymisedAt      DateTime?
  anonymisedById    String?
  anonymisedBy      Employee? @relation("CandidateAnonymisedBy", fields: [anonymisedById], references: [id])
  anonymisationNote String?

  // ── Archive (M11) ─────────────────────────────────────────────────────────────────────────────
  // Stale-but-lawful records moved out of the hot path. Deliberately NOT a separate cold-storage
  // table: `Application.candidateId` is a REQUIRED FK, so relocating the row would mean relocating
  // Application → ApplicationEvent → Scorecard → ScorecardRating → EeoResponse with it, or dropping
  // the constraint. A nullable timestamp buys the same thing for none of that risk — and because
  // an archived candidate is still THE SAME ROW, an erasure covers it automatically, so "the
  // archive is a second place PII hides" is structurally impossible rather than a hazard to police.
  //
  // Fully reversible (restore = set back to NULL), which is why the retention sweep is allowed to
  // act on its own and why these actions are gated in the app layer rather than the database.
  // `archivedById` is NULL when the sweep did it rather than a person.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   Employee? @relation("CandidateArchivedBy", fields: [archivedById], references: [id])

  // ── Great leads (M16) ─────────────────────────────────────────────────────────────────────────
  // "Strong, wrong role — call them when the next one opens." Same shape as the two states above: a
  // nullable timestamp plus who set it, because this table already expresses "a state a person is
  // in" that way and a boolean would throw away when the judgement was made.
  //
  // ⚠️ A LEAD IS STILL SWEPT BY THE RETENTION POLICY (see isEligibleForArchive, which deliberately
  // does NOT check these columns). Keeping someone in the ACTIVE pool forever because we once liked
  // them is exactly the indefinite retention the policy exists to bound. The pool at
  // /candidates/leads is what keeps them findable, and it shows archived leads on purpose — without
  // that, the sweep would silently empty the feature about a year after launch.
  //
  // ⚠️ ALL THREE ARE CLEARED BY app_erase_candidate. leadNote is free text that can name a person,
  // and a shell has no name, email or phone — so an erased lead is both a privacy leak and useless.
  leadMarkedAt   DateTime?
  leadMarkedById String?
  leadMarkedBy   Employee? @relation("CandidateLeadMarkedBy", fields: [leadMarkedById], references: [id])
  leadNote       String?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  applications    Application[]
  erasureRequests ErasureRequest[]
  // The profile an applicant maintains (M6). DELETED by app_erase_candidate — unlike a stage or a
  // rating there is nothing about the PROCESS here, only the person.
  employment      CandidateEmployment[]
  education       CandidateEducation[]
  // The portal login for this person, if they have ever signed in (M4). Optional: most candidates
  // never create one, and app_erase_candidate DELETES it outright.
  account         CandidateAccount?

  @@unique([orgId, email])
  // The candidate list hides anonymised shells and archived people by default, so these indexes
  // keep the hot path off both. It matters more than it looks: the RLS policy on this table calls a
  // SECURITY DEFINER function once per row SCANNED, so narrowing the scan narrows the function
  // calls too. (Declared here rather than hand-written as PARTIAL indexes, so Prisma owns them and
  // no future `migrate diff` tries to drop an index it doesn't know about.)
  @@index([orgId, anonymisedAt])
  @@index([orgId, archivedAt])
  // The leads pool filters on "marked" and orders by it — and unlike the two above it is a SMALL
  // subset of a large table, which is the case an index helps most.
  @@index([orgId, leadMarkedAt])
  // Trigram index for the candidate search. `getCandidates` matches with `contains` +
  // mode:"insensitive", which Prisma emits as ILIKE '%token%' — a pattern a normal B-tree cannot
  // serve at all, so the search was a guaranteed sequential scan. GIN + gin_trgm_ops is the index
  // type that CAN serve a leading-wildcard match. Declared here (rather than hand-written SQL) so
  // Prisma owns it, for the same anti-drift reason as the two above.
  @@index([firstName(ops: raw("gin_trgm_ops")), lastName(ops: raw("gin_trgm_ops")), email(ops: raw("gin_trgm_ops"))], type: Gin)
}

// One candidate's application to one job — the pipeline unit. `stage` is the fixed top-level pipeline;
// while stage = INTERVIEW, `currentRoundId` points at the job round they're in. RLS = app_can_see_job(jobId).
model Application {
  id                String           @id @default(uuid())
  stage             ApplicationStage @default(APPLIED)
  appliedAt         DateTime         @default(now())
  // WHERE THIS APPLICATION CAME FROM — the channel that produced this specific submission.
  //
  // Attribution belongs here rather than on Candidate because a person can apply more than once,
  // from different campaigns. While it lived on Candidate (set with COALESCE, so never updated) a
  // repeat applicant was credited to their FIRST channel every time, and every later campaign was
  // reported as producing nobody. Nothing errored — the figures were simply wrong, which is the
  // worst way for a reporting feature to fail.
  //
  // Nullable, and deliberately not backfilled for candidates with more than one application: for
  // them the original source genuinely does not say which application it described, and inventing
  // an answer is the same fiction this column exists to end. /reports shows those as "Unknown".
  //
  // SNAPSHOT of the campaign's display name at submit time (M2 — before that, free text).
  //
  // Kept alongside campaignId rather than replaced by it, for the reason ApplicationEvent.roundName
  // already exists: a campaign can be renamed or deleted years later, and history must not silently
  // change to match. The FK answers "which campaign is this, now"; this answers "what did we call it
  // when they applied". Reads prefer the FK and fall back to this.
  source            String?
  // Free text: the specifics, and the field an erasure blanks.
  rejectionReason   String?
  // Structured (M12): required by validation when moving to REJECTED, but NULLABLE in the schema —
  // every application rejected before this field existed has no category, and back-filling one
  // would be inventing a decision nobody made. Survives erasure; see the RejectionReason enum.
  rejectionCategory RejectionReason?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Denormalized so org-scoped reads/aggregations skip a join (and future public-apply inserts carry it).
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  // The campaign that produced this application (M2). NULL means unattributed — either it predates
  // the registry, or the public path was handed a slug it did not recognise, which is discarded
  // rather than recorded. SetNull for the same reason as currentRound: retiring a campaign must
  // never destroy an application, and `source` above still carries what it was called.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // WHAT THEY ACTUALLY SUBMITTED (M6) — work history and education, frozen at submit time.
  //
  // JSON rather than two more child tables, deliberately. This is display-only: a recruiter reads
  // "what did they send us", and nothing ever joins or filters it. A relational copy would buy
  // nothing and cost two more tables in the erasure registry, where every extra table is another
  // chance to forget one. Querying PEOPLE by employer stays possible through CandidateEmployment.
  //
  // The pairing is the point: the candidate edits their PROFILE freely, and an application already
  // under review does not change underneath the recruiter reading it — the same reasoning as
  // Application.source and ApplicationEvent.roundName.
  //
  // ⚠️ Both are blanked by app_erase_candidate: employers, dates and institutions are entirely about
  // the person (and name third parties).
  employmentSnapshot Json?
  educationSnapshot  Json?

  // M9: the interview slot(s) this application holds — at most one per round.
  interviewSlots InterviewSlot[]

  // THE CV THEY SENT FOR THIS ROLE (M7) — the third member of the snapshot family above, and the
  // one that escaped M6.
  //
  // Until M7 nobody could replace a résumé, so `Candidate.resumeKey` doubled as "what they applied
  // with". The moment an applicant can manage their own CV that stops being true: a recruiter
  // reading a March application would silently start seeing the August file. So the KEY is pinned
  // here at submit, exactly as the two snapshots above are.
  //
  // ⚠️ THE BLOB IS SHARED, NOT COPIED. This stores the key that was current at submit; replacing a
  // CV writes a NEW blob and repoints Candidate.resumeKey only, leaving every earlier application
  // pointing at the file it was actually submitted with. Applying without attaching anything pins
  // whatever was already on file, so "no file attached" still shows the recruiter a CV.
  //
  // ⚠️ Every key must stay reachable from a row, because app_erase_candidate sweeps storage using
  // keys it READS FROM THE DATABASE — an unreferenced blob is one erasure cannot destroy. That is
  // why app_applicant_set_resume only reports a superseded key for deletion when no Application
  // still pins it, and why erasure collects DISTINCT keys across here and Candidate.
  resumeKey      String?
  resumeFileName String?

  // The interview round the candidate is currently in (only while stage = INTERVIEW). SetNull so
  // editing/removing a round never destroys the application.
  currentRoundId String?
  currentRound   InterviewRound? @relation(fields: [currentRoundId], references: [id], onDelete: SetNull)

  // THE HIRE SEAM (M8). Set once HR has actually created this person's employee record, which is a
  // separate, deliberate act: reaching HIRED records the DECISION, this records the ONBOARDING.
  // Until it's set, the application sits in employee-records' onboarding queue.
  //
  // @unique so one Employee can never be claimed by two applications (NULLs stay distinct in
  // Postgres, so any number of applications may legitimately be un-onboarded). Written only through
  // app_link_hire — see the hire_seam migration for why a plain UPDATE isn't enough.
  hiredEmployeeId String?   @unique
  hiredEmployee   Employee? @relation("ApplicationHire", fields: [hiredEmployeeId], references: [id])

  events      ApplicationEvent[]
  scorecards  Scorecard[]
  // Offer versions (M14). Same reasoning as SalaryBand: a separate, manage-gated table, because this
  // row is readable by every interviewer on the hiring team.
  offers      Offer[]
  // Voluntary EEO self-identification (M10). Note what this relation does NOT give you: the table is
  // unreadable through Prisma by design, so `include: { eeoResponse: true }` returns nothing for
  // anyone. The relation exists for the schema's integrity, not for querying.
  eeoResponse EeoResponse?
  // Versioned consent (M6). Survives erasure by design — see the model.
  consent     ApplicationConsent?
  // Answers to the req's screening questions (M6b).
  answers     ApplicationAnswer[]

  @@unique([jobId, candidateId])
  @@index([jobId, stage])
  // The candidate list filters "has an application from this source" (getCandidates), which is the
  // read this helps. getSourceReport aggregates every application in the org and scans regardless.
  @@index([orgId, source])
  // M2: the source report joins Campaign to roll up per channel, and the candidate filter matches by
  // campaign slug — both drive off this column now.
  @@index([orgId, campaignId])
  // M7: app_applicant_set_resume asks "does any application still pin this key" on every CV
  // replacement, and that is the only lookup this table ever does by résumé key.
  @@index([resumeKey])
}

// A criterion this job scores candidates on (M7) — e.g. "System design", "Communication". Per-job and
// ordered, exactly like InterviewRound: the same "the req defines its own process" idea, applied to
// evaluation instead of stages.
model JobCompetency {
  id        String   @id @default(uuid())
  name      String
  position  Int
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  ratings ScorecardRating[]

  @@unique([jobId, position])
  @@index([jobId])
}

// One interviewer's written feedback on one candidate for one interview round (M7).
//
// Visibility is the suite's most interesting rule: a teammate may not read this until THEY have
// submitted their own scorecard for the same application — the anti-anchoring guard, enforced by
// app_can_see_scorecard, not by the UI. Recruiters/hiring managers (who run the debrief) always see
// everything. Editing stops at submit, enforced by the UPDATE policy.
model Scorecard {
  id             String          @id @default(uuid())
  status         ScorecardStatus @default(DRAFT)
  recommendation Recommendation?
  notes          String?
  submittedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Denormalized owner column — every ATS policy keys off jobId (same reason as ApplicationEvent).
  jobId String
  job   Job    @relation("ScorecardJob", fields: [jobId], references: [id])

  // SetNull, not Cascade: deleting a round must never destroy the feedback given in it (M5's
  // guarantee for candidates, applied here to interviewers' work).
  interviewRoundId String?
  interviewRound   InterviewRound? @relation(fields: [interviewRoundId], references: [id], onDelete: SetNull)

  authorEmployeeId String
  author           Employee @relation("ScorecardAuthor", fields: [authorEmployeeId], references: [id])

  ratings ScorecardRating[]

  // One scorecard per person per round on a given application.
  @@unique([applicationId, interviewRoundId, authorEmployeeId])
  @@index([applicationId])
  @@index([jobId])
}

// One competency's score inside a scorecard. `competencyName` is a SNAPSHOT taken at write time, so
// renaming or removing a competency later can never rewrite what a past debrief actually said — the
// same reasoning as ApplicationEvent.roundName and EmployeeHistory.departmentSnapshot.
model ScorecardRating {
  id        String   @id @default(uuid())
  rating    Int // 1–4, see RATING_SCALE in @hris/recruiting
  comment   String?
  createdAt DateTime @default(now())

  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  competencyId   String
  competency     JobCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  competencyName String

  @@unique([scorecardId, competencyId])
  @@index([scorecardId])
}

// Append-only pipeline history AND the hiring-decision compliance trail. UPDATE/DELETE are revoked
// from hris_app at the DB level (same guarantee as EmployeeAuditLog) — hiring history can't be
// rewritten even with a bug. `jobId` is denormalized so the RLS policy is a one-liner (like
// TimeEntry.employeeId). `roundName` is a SNAPSHOT string so editing/deleting a round can't rewrite
// what happened (the departmentSnapshot pattern). occurredAt is DB-defaulted (no backdating).
model ApplicationEvent {
  id         String            @id @default(uuid())
  fromStage  ApplicationStage?
  toStage    ApplicationStage
  roundName  String?
  note       String?
  occurredAt DateTime          @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Denormalized owner column so the RLS policy is the same one-liner as every other scoped table.
  jobId String
  job   Job    @relation("ApplicationEventJob", fields: [jobId], references: [id])

  actorId String
  actor   User   @relation("ApplicationEventActor", fields: [actorId], references: [id])

  deliveries NotificationDelivery[]

  @@index([applicationId, occurredAt])
}

// ONE ATTEMPT TO DELIVER NEWS OF ONE EVENT, to one recipient, down one channel (M8).
//
// ⚠️ THIS IS NOT "A NOTIFICATION". The notification IS the `ApplicationEvent` — it already exists, it
// is append-only, and the portal already renders it. This table records only what we tried to SEND,
// which is why the in-portal banner has no row here: it is derived at render time from the event
// trail, so there is nothing to deliver.
//
// ⚠️ IT HOLDS NO PERSONAL DATA, AND THAT IS LOAD-BEARING. No address, no subject, no body. The
// recipient is derivable — a null `recipientUserId` means "the candidate on this event", which is
// every row M8 writes. Because it describes the process rather than the person,
// `app_erase_candidate` deliberately does NOT touch it: events survive an erasure exactly as stages
// and ratings do, and so does the record that we wrote to someone about one.
//
// ⚠️ NEVER ADD AN ERROR-MESSAGE COLUMN. An SMTP bounce reads `550 no such user: nora@example.com` —
// storing it would put the recipient's address in the one table that promises not to hold it, and
// would do so only on the failure path where nobody is looking. Log the cause; store the status.
model NotificationDelivery {
  id          String              @id @default(uuid())
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  // Null until a send is actually attempted; PENDING rows are claims, not queued work.
  attemptedAt DateTime?
  createdAt   DateTime            @default(now())

  // ── THE SUBJECT: exactly ONE of these two is set ──────────────────────────────────────────────
  //
  // M8 keyed every delivery on an ApplicationEvent — each stage move writes exactly one, so its id
  // identifies the news precisely, with no window and no fuzzy "did we already send something like
  // this". M9 needs to notify an INTERVIEWER that a slot awaits their confirmation, and that is not
  // an event about an application at all.
  //
  // ⚠️ TWO REAL FOREIGN KEYS, NOT A `subjectType` + `subjectId` PAIR. A polymorphic id would have no
  // referential integrity, and every RLS'd table here relies on a denormalized owner column for a
  // one-line policy — which a polymorphic subject cannot express either. A CHECK constraint in the
  // migration enforces that exactly one is present.
  applicationEventId String?
  applicationEvent   ApplicationEvent? @relation(fields: [applicationEventId], references: [id], onDelete: Cascade)

  interviewSlotId String?
  interviewSlot   InterviewSlot? @relation(fields: [interviewSlotId], references: [id], onDelete: Cascade)

  // Denormalized owner column, so the RLS policy is the same one-liner as every other scoped table.
  jobId String
  job   Job    @relation("NotificationDeliveryJob", fields: [jobId], references: [id])

  // NULL = the candidate on this event (M8 writes nothing else). Present only so M9 can address a
  // staff interviewer about a slot awaiting confirmation without reopening this table. A real FK,
  // never a copy of anyone's contact details.
  recipientUserId String?
  recipientUser   User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])

  // ⚠️ THE REAL INDEX CARRIES `NULLS NOT DISTINCT`, WHICH PRISMA CANNOT EXPRESS. It is created that
  // way in the migration; this `@@unique` is the same three columns without the clause.
  //
  // That is not a fudge, it is the arrangement that makes both halves work, and it took a drift
  // check to get right:
  //   · Prisma CANNOT SEE the difference — `migrate diff` reports "no difference" against the live
  //     index — so the declaration here is accepted and the database keeps the stronger constraint.
  //   · The declaration is REQUIRED. Without it Prisma sees an index it does not know about and a
  //     future `migrate dev` generates a migration to DROP it, silently destroying the idempotency
  //     this table exists to provide.
  //   · `map:` pins the name to the migration's, or Prisma's own naming convention makes it want to
  //     rename the index on every diff.
  //
  // Why the clause matters at all: in Postgres NULLs in a unique index are DISTINCT by default, and
  // every row M8 writes has `recipientUserId IS NULL`. Without it two claims for the same event do
  // not collide, `ON CONFLICT` never fires, and the same person is emailed twice — with no error
  // anywhere. There is a psql check that claims twice, and a control proving the check can fail.
  // ⚠️ `interviewSlotId` HAD TO JOIN THIS INDEX, and leaving it out would have been silent.
  // The real index is NULLS NOT DISTINCT, so a NULL compares EQUAL. Every M9 slot notification has
  // `applicationEventId IS NULL`, which means without the slot id in the key, two notifications
  // about DIFFERENT slots to the SAME interviewer would collide as (NULL, EMAIL, user) — and the
  // second would be silently refused as an already-sent duplicate.
  @@unique([applicationEventId, interviewSlotId, channel, recipientUserId], map: "NotificationDelivery_subject_channel_recipient_key")
  @@index([applicationEventId])
  @@index([interviewSlotId])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Compliance (ATS M10) — EEO self-identification + the erasure lifecycle.
// ---------------------------------------------------------------------------

// A candidate's VOLUNTARY EEO self-identification, captured at the moment they applied.
//
// ⚠️ THIS TABLE IS UNREACHABLE THROUGH PRISMA, ON PURPOSE. Its migration enables row-level security
// with NO POLICIES AT ALL (default-deny) and revokes every privilege from hris_app. No query the
// application can write — today's or a future milestone's — can read a row. The only two ways in are
// SECURITY DEFINER functions: app_submit_application writes one, app_eeo_summary returns AGGREGATE
// counts to HR_ADMIN. The model exists so migrations and types stay honest, not so it can be read.
//
// Keyed to the APPLICATION, not the Candidate: the answers describe one submission at one moment. A
// person may answer differently a year later, and neither answer should overwrite the other.
model EeoResponse {
  id               String              @id @default(uuid())
  gender           EeoGender           @default(DECLINED)
  ethnicity        EeoEthnicity        @default(DECLINED)
  veteranStatus    EeoVeteranStatus    @default(DECLINED)
  disabilityStatus EeoDisabilityStatus @default(DECLINED)
  submittedAt      DateTime            @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Denormalized so the aggregate can group per requisition without joining an RLS-protected table
  // from inside a SECURITY DEFINER function — the same reasoning as ApplicationEvent.jobId.
  jobId String
  job   Job    @relation("EeoResponseJob", fields: [jobId], references: [id])

  @@index([orgId, jobId])
}

// A request to erase a candidate's personal data. Deliberately NOT self-executing: anyone can type
// an email address, so an anonymous request creates a task for HR, never a deletion. `email` is the
// address as submitted; `candidateId` is what it resolved to (SetNull, because the candidate row
// outlives the erasure as an anonymised shell and this request must survive it).
model ErasureRequest {
  id           String               @id @default(uuid())
  email        String
  status       ErasureRequestStatus @default(PENDING)
  reason       String? // why the requester asked, in their words
  decisionNote String? // why HR completed or refused it, in theirs
  requestedAt  DateTime             @default(now())
  resolvedAt   DateTime?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   Employee? @relation("ErasureResolvedBy", fields: [resolvedById], references: [id])

  @@index([orgId, status])
}

// A record that someone produced an EEO export (M12).
//
// Exists because the FILING variant is the one path in the system that returns EXACT demographic
// counts — the numbers the on-screen report deliberately withholds. That path has to be narrow and
// it has to leave a trace, otherwise the suppression rule everywhere else is decoration.
//
// APPEND-ONLY at the database: UPDATE and DELETE are revoked from hris_app, the same guarantee as
// ApplicationEvent and EmployeeAuditLog. An audit trail that its subject can edit is not one.
//
// ⚠️ Deliberately NOT EmployeeAuditLog: that table's `employeeId` is a REQUIRED foreign key, and an
// org-wide export is not *about* any one employee. Writing the actor's own id there would be a lie,
// and it would pollute their profile timeline with events that never happened to them.
model EeoExportLog {
  id                String           @id @default(uuid())
  variant           EeoExportVariant
  exportedAt        DateTime         @default(now())
  // What the file actually contained, so the log answers "how much" as well as "who and when".
  rowCount          Int              @default(0)
  // How many requisitions had no EEO job category at export time — a data-quality figure that
  // matters most in hindsight, when someone asks why a filed return didn't add up.
  uncategorisedJobs Int              @default(0)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  actorId String
  actor   User   @relation("EeoExportActor", fields: [actorId], references: [id])

  @@index([orgId, exportedAt])
}

// ---------------------------------------------------------------------------
// Compensation (ATS M14) — the approved band on a requisition, and the offers written against it.
//
// ⚠️ WHY THESE ARE TABLES AND NOT COLUMNS. The obvious design puts salaryMin/salaryMax on Job and a
// salary on Application. Both of those rows are readable by the WHOLE hiring team — `job_read` and
// `application_read` delegate to app_can_see_job, which includes INTERVIEWERs — and row-level
// security cannot hide a COLUMN. Guarding columns app-side (the employee-records comp guard) works
// only while every present and future query remembers to; getJobForManage already does a bare
// `findFirst` with no select and would have leaked the band on day one.
//
// As their own tables they carry their own policies, delegating to app_can_manage_job — the function
// that ALREADY excludes interviewers. Postgres refuses them the rows from any code path, which is a
// guarantee no amount of later carelessness can undo.
// ---------------------------------------------------------------------------

// The approved pay range for a requisition. One per Job.
model SalaryBand {
  id        String   @id @default(uuid())
  salaryMin Decimal  @db.Decimal(12, 2) // money is never a float — same as EmployeeHistory.salary
  salaryMax Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  payBasis  PayBasis @default(PER_YEAR)
  // Pay-transparency posting. When true, app_public_jobs() returns the range on the careers page.
  // A deliberate act, never a default: several jurisdictions REQUIRE the range on a job ad, and
  // several employers still treat it as confidential, so the app must not decide for the operator.
  //
  // Note the honest consequence: once posted, withholding the band from interviewers is theatre.
  // That is a choice the recruiter makes knowingly, not a hole in the access model.
  postPublicly Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// One VERSION of an offer to one candidate. See OfferStatus for the lifecycle.
model Offer {
  id       String      @id @default(uuid())
  version  Int         @default(1)
  status   OfferStatus @default(DRAFT)
  salary   Decimal     @db.Decimal(12, 2)
  currency String      @default("USD")
  payBasis PayBasis    @default(PER_YEAR)
  // The proposed first day. Nullable: an offer is often agreed in principle before a date is.
  startDate DateTime?
  // Free text. BOTH of these are blanked by app_erase_candidate — they are exactly where a person's
  // name survives ("she mentioned a competing offer from …"), the same reasoning as Scorecard.notes.
  notes           String?
  outOfBandReason String?
  // The band AS IT WAS when this version was written. Snapshots, like ApplicationEvent.roundName and
  // ScorecardRating.competencyName: re-approving the band next quarter must not silently rewrite
  // what a past offer was measured against. Null when the req had no band at the time.
  bandMinSnapshot Decimal? @db.Decimal(12, 2)
  bandMaxSnapshot Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Denormalized owner column so the RLS policy is the same one-liner as every other scoped table
  // in the ATS (the ApplicationEvent.jobId trick).
  jobId String
  job   Job    @relation("OfferJob", fields: [jobId], references: [id])

  createdById String
  createdBy   User   @relation("OfferCreatedBy", fields: [createdById], references: [id])

  @@unique([applicationId, version])
  @@index([jobId])
}
