# Copy this file to .env and adjust as needed. NEVER commit .env.
#
# Two connection strings, on purpose:
#
#   DATABASE_URL  → the RESTRICTED `hris_app` role. Used by @hris/database at
#                   RUNTIME (the Prisma client the app imports). It cannot
#                   UPDATE/DELETE the audit log — that's the compliance guarantee.
#
#   DIRECT_URL    → the `postgres` OWNER role. Used only by Prisma Migrate and
#                   Prisma Studio to create/alter tables and run privileged SQL.
#
# Prisma reads `directUrl` from the datasource for migrations and `url` for the
# runtime client. Host/port/db match docker-compose.yml.
DATABASE_URL="postgresql://hris_app:hris_app_pw@localhost:5433/hris?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/hris?schema=public"

# Auth.js signing secret (per app). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
# The employee-records app keeps its own copy in apps/employee-records/.env.local
AUTH_SECRET="replace-me-with-a-random-secret"

# Outbound email (new-hire invites). In dev these point at the Mailpit container from
# docker-compose.yml; in production swap for a real SMTP provider. APP_BASE_URL is the
# public origin used to build the invite link (…/set-password?token=…).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="FrogsAtWorkHR <no-reply@frogsatwork.test>"
APP_BASE_URL="http://localhost:3000"

# ── Time & Attendance app (apps/time-management) extras ──────────────────────
# Kept in apps/time-management/.env.local. Both are OPTIONAL in local dev.
#
#   CRON_SECRET  → bearer token guarding the monthly accrual endpoint
#                  (/api/cron/accrue). In production, name the Vercel env var
#                  exactly CRON_SECRET and Vercel Cron sends it automatically.
CRON_SECRET="replace-me-with-a-random-secret"
#
#   UPSTASH_*    → login rate limiting (fixed-window, minimal Redis). If unset,
#                  rate limiting is a transparent no-op (Redis never contacted).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Recruiting: candidate-facing URLs and contact (M8 / M11) ─────────────────────────────────
#
#   PORTAL_BASE_URL       → where a CANDIDATE reads their own applications. Set on the ATS
#                           project, and NOT the same as its APP_BASE_URL: the ATS is a staff tool
#                           behind a login, so notification links must point at the portal instead.
#                           ⚠️ Unset in production means every notification links to localhost.
#
#   RECRUITING_REPLY_TO   → one address a candidate can actually write to. Used as Reply-To on
#                           candidate email and shown beside a booked interview time, because
#                           interview times are chosen ONCE and a reschedule needs a human.
#                           ⚠️ Everything else here sends from no-reply@, so without this the
#                           instruction "get in touch" has nowhere to point. Deliberately an
#                           address rather than a named person: it survives someone leaving and
#                           publishes no personal staff address to strangers.
PORTAL_BASE_URL="http://localhost:3003"
RECRUITING_REPLY_TO=""

# ── Candidate portal (app 4) ─────────────────────────────────────────────────────────────────
# ⚠️ ITS OWN SECRET, AND A DIFFERENT NAME ON PURPOSE. Applicants and staff are separate auth
# realms: app 4 signs its session with this, under its own cookie
# (candidate-portal.session-token), so a live staff session can never satisfy /portal — a
# property that is tested, not assumed. Sharing AUTH_SECRET would quietly weaken it.
# Generate with: openssl rand -base64 33
CANDIDATE_AUTH_SECRET=""

# ── File storage ─────────────────────────────────────────────────────────────────────────────
# `local` writes under STORAGE_DIR; `vercel-blob` uses the private Blob store.
# ⚠️ IN PRODUCTION THIS MUST BE vercel-blob. Left unset, uploads succeed and write to an
# ephemeral local directory that disappears with the instance — résumés vanish with nothing
# erroring, which is the worst possible failure mode for this particular file.
STORAGE_DRIVER="local"
# Only used by the `local` driver. Defaults to .storage in the repo root.
STORAGE_DIR=".storage"

# ── Seeding (optional) ───────────────────────────────────────────────────────────────────────
# Set to generate extra demo applications so the EEO report has enough rows to be non-trivial.
# Unset in normal development; the base seed is already a complete demo.
SEED_DEMO_VOLUME=""
